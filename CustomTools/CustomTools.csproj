<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- 由 Codex 修改：启用 WinForms，切换到 Windows TFM -->
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>Resources\Main.ico</ApplicationIcon>
		<!-- 版本信息配置 -->
		<!-- 由 Codex 修改：新增 Settings 菜单项，提升版本号以触发注册表更新 -->
		<FileVersion>1.12.33</FileVersion>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="Resources\Main.ico" />
		<Content Include="Resources\Rename.ico" />
		<Content Include="Resources\Delete.ico" />
		<Content Include="Resources\Config.ico" />
		<Content Include="Resources\Unins.ico" />
		<!-- 由 Codex 添加 -->
		<Content Include="Resources\VideoCheck.ico" />
		<!-- 由 Codex 添加 -->
		<Content Include="Resources\Settings.ico" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\..\NotNet\ConsoleKit\ConsoleKit.csproj" />
	  <ProjectReference Include="..\..\NotNet\Public\PIToolKit.Public.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Resource.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resource.resx</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Resource.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resource.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
	  <None Update="Configs\config.cfg">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="FFmpeg\ffmpeg.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="FFmpeg\ffplay.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="FFmpeg\ffprobe.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>
