<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<!-- 由 Codex 修改：启用 WinForms，切换到 Windows TFM -->
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>Resources\Main.ico</ApplicationIcon>

		<!-- 版本信息配置 -->
		<!-- 由 Codex 修改：新增 Settings 菜单项，提升版本号以触发注册表更新 -->
		<!-- 由 Codex 修改：视频查重图标更新后提升版本，触发右键菜单重新安装 -->
		<!-- 由 Codex 修改：修复视频查重缓存加载并改为连续哈希存储，提升版本触发菜单更新 -->
		<!-- 由 Codex 修改：新增机械硬盘与固态硬盘差异化并行配置 -->
		<!-- 由 Codex 修改：按剩余文件总大小估算视频查重剩余时间 -->
		<!-- 由 Codex 修改：改用阶段化工作量估算视频查重剩余时间 -->
		<!-- 由 Codex 修改：无效帧文件移入回收站并增加缓存原子写入保护 -->
		<!-- 由 Codex 修改：新增增量缓存日志并即时回收无效帧视频 -->
		<!-- 由 Codex 修改：新增批量勾选每组非首个视频按钮 -->
		<!-- 由 Codex 修改：新增视频包含查询菜单与图标 -->
		<!-- 由 Codex 修改：修正视频包含查询为源视频包含较短视频 -->
		<!-- 由 Codex 修改：统一视频包含查询图标风格并切换全局批量包含扫描 -->
		<!-- 由 Codex 修改：包含查询结果支持播放、勾选和批量删除 -->
		<!-- 由 Codex 修改：结果窗口关闭后输出删除统计并自动关闭控制台 -->
		<!-- 由 Codex 修改：包含查询忽略全零哈希并移除哈希种类硬门槛 -->
		<!-- 由 Codex 修改：包含查询结果树增加打开视频和复制节点信息右键菜单 -->
		<!-- 由 Codex 修改：删除包含查询文件后同步移除对应 pHash 缓存 -->
		<!-- 由 Codex 修改：包含查询窗口关闭后合并 pHash 增量缓存 -->
		<!-- 由 Codex 修改：使用低分辨率时间轴复核包含位置并过滤误报 -->
		<!-- 由 Codex 修改：包含查询增加剩余时间并调整结果树双击行为 -->
		<!-- 由 Codex 修改：包含查询结果默认选中全部子节点 -->
		<!-- 由 Codex 修改：包含查询父节点始终保持未勾选 -->
		<FileVersion>1.13.12</FileVersion>

		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="Resources\Main.ico" />
		<Content Include="Resources\Rename.ico" />
		<Content Include="Resources\Delete.ico" />
		<Content Include="Resources\Config.ico" />
		<Content Include="Resources\Unins.ico" />
		<!-- 由 Codex 添加 -->
		<Content Include="Resources\VideoCheck.ico" />
		<!-- 由 Codex 添加 -->
		<Content Include="Resources\Settings.ico" />
		<!-- 由 Codex 添加：视频包含查询菜单图标 -->
		<Content Include="Resources\VideoContainsQuery.ico" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\..\NotNet\ConsoleKit\ConsoleKit.csproj" />
	  <ProjectReference Include="..\..\NotNet\Public\PIToolKit.Public.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Resource.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resource.resx</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Resource.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resource.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
	  <None Update="Configs\config.cfg">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="FFmpeg\ffmpeg.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="FFmpeg\ffplay.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="FFmpeg\ffprobe.exe">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>
